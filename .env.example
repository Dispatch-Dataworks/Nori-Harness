# Nori — example environment file.
#
# The real file lives OUTSIDE this project folder entirely (2026-09-14,
# moved deliberately so a real key is never even one .gitignore mistake
# away from being committed): nori.env in a directory named
# "<repo-folder-name>-env", sibling to the whole repo, one file per app.
# See server.py's own ENV_PATH constant for the exact, portable
# derivation. This file (in the repo) is documentation only, never read
# at runtime -- copy it there and fill in real values. Example, if this
# repo is cloned as "myproject":
#   cp .env.example ../myproject-env/nori.env
# This file grows as each build phase adds settings; every setting that
# exists gets documented here, not just the ones needed to get started.
#
# This file should work for any operator on any machine with no edits beyond
# filling in their own values and picking their own equivalent directory.

# ── Server ──────────────────────────────────────────────────────────────
# Port Nori's web server listens on.
NORI_PORT=8877

# Binds 127.0.0.1 only by default — put it behind your own reverse proxy
# or tunnel if you want it reachable from outside the machine it's running
# on. Leave this unset for a normal install. Change it to 0.0.0.0 only
# inside a container, where the container boundary is the isolation
# instead of loopback-only binding (a process bound to 127.0.0.1 inside a
# container is generally unreachable from outside that container even
# with the port published).
# NORI_BIND_HOST=127.0.0.1

# Set this to 1/true/yes ONLY for local testing over plain HTTP (no TLS).
# Leave unset in any real deployment — the session cookie is Secure by
# default and should stay that way the moment this is reachable from
# anywhere but localhost.
# NORI_ALLOW_INSECURE_COOKIE=

# Set this to 1/true/yes ONLY if this instance sits behind a reverse proxy,
# load balancer, or tunnel that YOU control and that strips any inbound
# CF-Connecting-IP/X-Forwarded-For before setting its own. Those headers are
# otherwise spoofable by any client that can reach this server directly, and
# this app's per-IP login rate limiter trusts them for exactly that IP —
# leaving this unset (the safe default) uses the real TCP connection's IP
# instead. If you don't know what's in front of this instance, leave it unset.
# NORI_TRUST_PROXY=

# ── Model provider ───────────────────────────────────────────────────────
# REQUIRED. Your own OpenRouter API key — https://openrouter.ai/keys.
# Every operator brings their own; there's no shared/billed key anywhere
# in this app. Every request enforces zero-data-retention with the
# provider regardless of which model you pick.
OPENROUTER_API_KEY=

# Optional — sensible defaults if left unset. NORI_MODEL defaults to a
# model confirmed (in this project's own testing) to support native tool
# calling, which matters once tools exist (Phase 4+); change it if you
# want a different model, but check tool-calling support first if you're
# past Phase 4.
# NORI_MODEL=x-ai/grok-4.3
# NORI_MAX_TOKENS=1024
# NORI_TEMPERATURE=0.8
# NORI_API_TIMEOUT_S=120
# NORI_API_RETRIES=2

# Image generation's own timeout (chat.openrouter_image, imagegen.py) --
# separate from NORI_API_TIMEOUT_S above because real image generation
# runs much longer than a chat completion. 120s default, raised
# 2026-09-17 from a hardcoded 60s after real .nori.log data showed 27%
# of calls timing out at 60s and genuine successes reaching 54.2s.
# NORI_IMAGE_TIMEOUT_S=120

# Topic-triggered memory activation's embedding model (memory.py) -- the
# semantic pass for the safety/constraint tier only. Same OPENROUTER_API_KEY
# above, no separate credential. Change only if you want a different
# OpenRouter-hosted embeddings model; existing cached embeddings are
# recomputed automatically once this no longer matches what's stored.
# NORI_EMBEDDING_MODEL=openai/text-embedding-3-small
# NORI_EMBED_TIMEOUT_S=15

# ── Voice layer (TTS/STT) ────────────────────────────────────────────────
# REQUIRED for voice to work at all -- a direct OpenAI key, separate from
# OPENROUTER_API_KEY above. Checked directly against OpenRouter's own real
# model collection (not assumed): it carries NO OpenAI TTS model at all,
# so gpt-4o-mini-tts needs this regardless. gpt-4o-mini-transcribe (STT)
# is technically available on OpenRouter too, but stays on this same key
# for simplicity -- one vendor, one pipeline. Get a key at
# https://platform.openai.com/api-keys. Leave unset and the play button /
# push-to-talk mic button simply won't produce audio -- nothing else in
# the app depends on this.
OAI_API_KEY=

# ── Connected accounts (optional — email/calendar tools are scaffolded,
# not connected) ──────────────────────────────────────────────────────────
# REQUIRED for any OAuth connection to work at all: the exact base URL
# this instance is reachable at, with no trailing slash. You register
# THIS SAME URL + "/oauth/callback/<provider>" as the redirect URI in each
# provider's own developer console -- it has to match exactly.
# NORI_PUBLIC_URL=https://your-tunnel-hostname.example

# Google: one shared OAuth app/credential pair covers all four Google
# providers (gmail, google_calendar, google_contacts, google_drive) --
# GOOGLE_CLIENT_ID/SECRET, not NORI_-prefixed (2026-09-18, his own naming;
# see oauth.py's own comment on the gmail entry for why this replaced four
# separate per-provider names).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft: two separate app registrations, two credential pairs --
# NOT one shared pair, on the operator's own explicit choice: a real work
# Microsoft 365 tenant account and a personal Microsoft account can't
# share one app registration the way the four Google providers above
# share one. NORI_OUTLOOK_CLIENT_ID/SECRET (the work-tenant app) covers
# outlook (mail+calendar), outlook_contacts, onedrive_work, and
# sharepoint -- four separate connect flows, one credential pair, same
# shared-pair shape Google uses. NORI_OUTLOOK_PERSONAL_CLIENT_ID/SECRET
# (a second, separate app, registered for personal Microsoft accounts
# only) covers onedrive_personal alone.
# NORI_OUTLOOK_CLIENT_ID=
# NORI_OUTLOOK_CLIENT_SECRET=
# NORI_OUTLOOK_PERSONAL_CLIENT_ID=
# NORI_OUTLOOK_PERSONAL_CLIENT_SECRET=

# Daily backups (2026-09-18, revised 2026-09-19) -- see backup.py's own
# module docstring / docs/backups.md. Encrypts the whole local backup
# archive before it's ever written to disk or uploaded -- unset means
# backups refuse to write unencrypted rather than silently skipping
# this. A PASSPHRASE (20+ characters -- a real multi-word one, not a
# padded single word) is the documented default: something you can
# actually remember, never written down next to the backups it
# protects. A random per-archive salt travels in the archive itself, so
# nothing but this passphrase needs to be kept anywhere. A raw generated
# Fernet key still works too, if you'd rather manage real key material:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NORI_BACKUP_KEY=

# Exclude one or more named subfolders under workfiles/ from every backup --
# comma-separated, matched by exact folder name at any depth. For a large,
# regenerable derived artifact (a generated snapshot, a cache directory) that
# doesn't belong in backup-worthy data. "backups/" (this app's own output)
# is always excluded regardless of this setting.
# NORI_BACKUP_EXCLUDE_DIRS=

# Skylight Calendar's real integration mechanism is unconfirmed (it may
# not even be OAuth) -- these two exist for symmetry but won't do anything
# until that's resolved. See oauth.py's module docstring.
# NORI_SKYLIGHT_CLIENT_ID=
# NORI_SKYLIGHT_CLIENT_SECRET=

# ── Tool-calling / rate limits ───────────────────────────────────────────
# All optional -- generous, sensible defaults if left unset.
# NORI_MAX_TOOL_ROUNDS=4          # tool-calling rounds per turn before giving up
# NORI_TOOL_RATE_LIMIT=30         # calls per (user, tool) allowed per window below
# NORI_TOOL_RATE_WINDOW_S=60
# NORI_MEMORY_CONTEXT_CHARS=1500  # the always-on memory slice's hard character budget
# NORI_EMOTION_DECAY_MINUTES=45   # idle time before her shown state resets to neutral
# NORI_SUBAGENT_TIMEOUT_S=120     # wall-clock timeout for a dispatched sub-agent job -- the
#                                 WHOLE job now that one can run several tool-calling rounds
#                                 (see the sub-agent roster's own per-agent tool-call/byte
#                                 limits) -- not reset per round, so a heavy tool user may
#                                 need this raised
# NORI_TOOLBUILDER_TIMEOUT_S=10   # wall-clock timeout for a generated tool's sandboxed run
# NORI_SCHEDULER_INTERVAL_MIN=15  # how often the proactive-message check runs
# NORI_REFLECTION_EVERY_MSGS=25   # infer memory after this many messages since the last pass
# NORI_REFLECTION_GAP_HOURS=18    # ...or after this long away, if anything's unreflected
# NORI_MCP_TIMEOUT_S=20           # wall-clock timeout for a call to a connected MCP server

# ── Web search / fetch (see docs/web-search-and-fetch.md for full setup +
# the settings pane's own controls) ──────────────────────────────────────
# REQUIRED for the search tool to work at all -- free tier is 1,000
# credits/month, no card, from https://app.tavily.com. Web fetch (an
# arbitrary URL) needs no key -- it's a plain outbound request this app
# makes itself. Leave unset and search is honestly reported as
# unavailable rather than attempting a broken call.
TAVILY_API_KEY=

# ── Working folder (per-user files she can view) ─────────────────────────
# All optional -- generous, sensible defaults if left unset. Whether she
# can look at IMAGES in the working folder is a separate, per-user
# toggle on the /files page itself, not an env var -- it sends the image
# to a vision model, which is a privacy decision each user makes for
# their own account.
# NORI_WORKFILE_MAX_FILE_MB=25    # largest single file allowed
# NORI_WORKFILE_MAX_USER_MB=250   # cap on one user's total working folder
# NORI_WORKFILE_MAX_USER_COUNT=500  # cap on one user's total file+folder count
# NORI_WORKFILE_MAX_TOTAL_MB=5000  # system-wide cap across every user combined
# NORI_VISION_MODEL=qwen/qwen3-vl-235b-a22b-instruct

# ── Testing isolation (optional — leave unset for normal/live use) ───────
# Point a throwaway instance at its own data/prompts directories instead of
# the real ones. Required together, never just one.
# NORI_DATA_DIR=
# NORI_PROMPTS_DIR=
# Set to skip the server writing its own .nori.log/.err (server.py's
# _redirect_logs) -- useful for a throwaway test whose own process
# capture already handles output, so it doesn't also append to files
# under this real directory.
# NORI_NO_LOGFILE=

# (More settings land here as each build phase adds them.)
